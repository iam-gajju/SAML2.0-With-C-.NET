@{
    ViewBag.Title = "Signed In";
}
<h1>Signed In</h1>
<p><strong>Email:</strong> @ViewBag.Email</p>
<p><strong>Name:</strong> @ViewBag.DisplayName</p>
<h2>Claims</h2>
@if (ViewBag.Claims != null)
{
    <ul>
        @foreach (var claim in ViewBag.Claims)
        {
            <li>@claim</li>
        }
    </ul>
}
else
{
    <p>No claims available.</p>
}